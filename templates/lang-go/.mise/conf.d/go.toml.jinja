# mise reads every .mise/conf.d/*.toml, so a layer contributes its own tools
# without touching a shared file.
[tools]
go = "@@GO_VERSION@@"
golangci-lint = "@@GOLANGCI_LINT_VERSION@@"
# No govulncheck here: `just go-vuln` builds it with the pinned Go through `go run`,
# because a binary mise cached is not rebuilt when GO_VERSION moves.
