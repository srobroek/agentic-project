# Go recipes, imported by the root justfile.

# Format, lint, and test
[group('go')]
go: go-fmt-check go-lint go-test

# Format. Not `gofmt -w .`, which walked into node_modules: a CDK app ships Go
# templates named `%name%.template.go` that do not parse, and gofmt rewrote the rest.
[group('go')]
go-fmt:
    find . \( -name node_modules -o -name vendor -o -name .git \) -prune -o -name '*.go' -type f -exec gofmt -w {} +

# Report formatting without changing a file. `just check` runs this one, because
# a task called check must not rewrite the tree it is checking: it cannot then be
# run on a dirty checkout, and in CI it reports success having edited the files.
# `just go-fmt` is the writer.
[group('go')]
go-fmt-check:
    #!/usr/bin/env bash
        set -euo pipefail
        unformatted=$(find . \( -name node_modules -o -name vendor -o -name .git \) -prune -o -name '*.go' -type f -exec gofmt -l {} +)
        if [ -n "$unformatted" ]; then
          echo "gofmt would rewrite:" >&2
          echo "$unformatted" >&2
          exit 1
        fi

# Lint. gosec and revive are enabled in .golangci.yml, not passed here
[group('go')]
go-lint:
    golangci-lint run ./...

# Test, with the race detector
[group('go')]
go-test:
    go test -race ./...

# Built by the pinned Go at the pinned version, as the GitHub workflow builds it. A
# binary mise cached is not rebuilt when GO_VERSION moves, and govulncheck built by
# go1.26 refused a go1.27 module: "package requires newer Go version go1.27
# (application built with go1.26)". `go run` keys its build cache on the toolchain.

# Known vulnerabilities in the dependency graph
[group('go')]
go-vuln:
    go run golang.org/x/vuln/cmd/govulncheck@v@@GOVULNCHECK_VERSION@@ ./...

# Fail when go.mod or go.sum is not tidy
[group('go')]
go-tidy-check:
    go mod tidy -diff

# Coverage
[group('go')]
go-cov:
    go test -race -coverprofile=coverage.out -covermode=atomic ./...
    go tool cover -func=coverage.out | tail -1

# Downloads into the shared module cache rather than the tree, so a warm run is 15ms.

# Download the locked module dependencies
[group('go')]
go-install:
    go mod download
