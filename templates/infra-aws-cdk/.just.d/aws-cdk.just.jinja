# AWS CDK validation without cloud mutation.
#
# The application itself is generated by the native CDK CLI, not templated: a
# hand-written stack would go stale against every CDK release. `aws-cdk-init` is the
# first task to run, once, and it commits nothing -- review and commit the result.

# Generate the CDK application with the native CDK CLI. Run once; refuses to clobber
[group('infrastructure')]
aws-cdk-init:
    python3 scripts/init_aws_cdk.py --dest @@AWS_CDK_DEST_SHELL@@ --cdk-version @@AWS_CDK_VERSION@@

# Restore the generated CDK application from its committed lockfile
[group('infrastructure')]
aws-cdk-install:
    cd @@AWS_CDK_DEST_SHELL@@ && bun install --frozen-lockfile

# Synthesize CloudFormation locally; never bootstrap or deploy
[group('infrastructure')]
aws-cdk-synth:
    cd @@AWS_CDK_DEST_SHELL@@ && bun run cdk synth

# A gate that fails for a directory nobody created yet says nothing about the code,
# so this one stands down until the app exists. `just` reads only the comment line
# directly above a recipe as its description, so that line goes last.

# Aggregate used by just check; stands down until aws-cdk-init has generated the app
[group('infrastructure')]
aws-cdk:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! -d @@AWS_CDK_DEST_SHELL@@ ]]; then
      echo "aws-cdk: @@AWS_CDK_DEST_SHELL@@/ not generated yet; run 'just aws-cdk-init'"
      exit 0
    fi
    just aws-cdk-synth
