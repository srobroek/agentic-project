# Go recipes, imported by the root justfile.

# Format, lint, and test
[group('go')]
go: go-fmt-check go-lint go-test

# Not `gofmt -w .`, which walked into node_modules: a CDK app ships Go templates
# named `%name%.template.go` that do not parse, and gofmt rewrote the rest.
#
# Format
[group('go')]
go-fmt:
    find . \( -name node_modules -o -name vendor -o -name .git \) -prune -o -name '*.go' -type f -exec gofmt -w {} +

# Report formatting without changing a file. `just check` runs this one, because
# a task called check must not rewrite the tree it is checking: it cannot then be
# run on a dirty checkout, and in CI it reports success having edited the files.
# `just go-fmt` is the writer.
[group('go')]
go-fmt-check:
    #!/usr/bin/env bash
        set -euo pipefail
        unformatted=$(find . \( -name node_modules -o -name vendor -o -name .git \) -prune -o -name '*.go' -type f -exec gofmt -l {} +)
        if [ -n "$unformatted" ]; then
          echo "gofmt would rewrite:" >&2
          echo "$unformatted" >&2
          exit 1
        fi

# Lint. gosec and revive are enabled in .golangci.yml, not passed here
[group('go')]
go-lint:
    golangci-lint run ./...

# Test, with the race detector
[group('go')]
go-test:
    go test -race ./...

# Built by the pinned Go at the pinned version, as the GitHub workflow builds it. A
# binary mise cached is not rebuilt when GO_VERSION moves, and govulncheck built by
# go1.26 refused a go1.27 module: "package requires newer Go version go1.27
# (application built with go1.26)". `go run` keys its build cache on the toolchain.

# Known vulnerabilities in the dependency graph
[group('go')]
go-vuln:
    #!/usr/bin/env bash
    set -euo pipefail
    status=0
    go run golang.org/x/vuln/cmd/govulncheck@v@@GOVULNCHECK_VERSION@@ ./... || status=$?
    # `go run <module>@<version>` downloads through GOPROXY, and on a network that
    # cannot reach the proxy the failure is a bare timeout naming no fix. Gated on the
    # proxy really not answering, so a genuine vulnerability report never carries a
    # network excuse, and on 127 so a missing curl is not read as a dead proxy.
    if [ "$status" -ne 0 ]; then
      proxy=$(go env GOPROXY | cut -d, -f1)
      reachable=0
      if [[ "$proxy" == https://* ]]; then
        curl -sSf --max-time 5 -o /dev/null "$proxy" 2>/dev/null || reachable=$?
      fi
      if [ "$reachable" -ne 0 ] && [ "$reachable" -ne 127 ]; then
        echo "" >&2
        echo "go-vuln: $proxy did not answer, and this check is downloaded through it." >&2
        echo "  On a network that blocks the module proxy, fetch from source instead:" >&2
        echo "    GOPROXY=direct just go-vuln" >&2
      fi
    fi
    exit "$status"

# Fail when go.mod or go.sum is not tidy
[group('go')]
go-tidy-check:
    go mod tidy -diff

# Coverage
[group('go')]
go-cov:
    go test -race -coverprofile=coverage.out -covermode=atomic ./...
    go tool cover -func=coverage.out | tail -1

# Downloads into the shared module cache rather than the tree, so a warm run is 15ms.

# Download the locked module dependencies
[group('go')]
go-install:
    go mod download
