# .mise/conf.d/hooks.toml -- the binaries the hygiene hooks call.
#
# The hooks invoke these through `language: system`, so this pin is what makes a
# version mean the same thing locally and in CI. Upstream pre-commit hook repos
# are not used for these: most of the tools publish none, and a repo pin would
# drift from the binary on PATH.
#
# betterleaks uses the latest version available to the mise registry after its
# minimum_release_age window, so this pin remains installable on fresh clones.
[tools]
prek = "@@PREK_VERSION@@"
# hooks-merge runs merge_hooks.py through `uv run --with pyyaml`; this exact latest-stable
# setup input is authoritative even when the repository has no Python layer.
uv = "@@UV_VERSION@@"
betterleaks = "@@BETTERLEAKS_VERSION@@"
trufflehog = "@@TRUFFLEHOG_VERSION@@"
typos = "@@TYPOS_VERSION@@"
shellcheck = "@@SHELLCHECK_VERSION@@"
actionlint = "@@ACTIONLINT_VERSION@@"
zizmor = "@@ZIZMOR_VERSION@@"
taplo = "@@TAPLO_VERSION@@"
lychee = "@@LYCHEE_VERSION@@"
