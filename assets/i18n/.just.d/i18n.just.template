# Recurring catalog gates for every accepted internationalization library.

# Install or prepare each catalog tool in a clean checkout
[group('i18n')]
i18n-prepare:
    #!/usr/bin/env bash
    set -euo pipefail
@@I18N_PREPARE_COMMANDS@@

# The drift check comes last and is not an answer: the layer ships the script,
# so the layer runs it. I18N_CHECK_COMMANDS adds to it, one line per further
# deployable.
#
# Reject missing, orphaned, or invalid messages
[group('i18n')]
i18n:
    #!/usr/bin/env bash
    set -euo pipefail
@@I18N_CHECK_COMMANDS@@
    node scripts/check-i18n-locale-drift.mjs @@I18N_PROJECT_DIR@@
