import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import AxeBuilder from "@axe-core/playwright";
import { expect, test } from "@playwright/test";

// The surfaces and web servers are read from JSON at run time rather than inlined.
// A JSON answer has quoted keys, which no JS formatter emits, and its length decides
// whether the formatter wants the call on one line or three -- so no fixed layout in
// this file could satisfy `just check` for every answer. The data files are excluded
// from the formatter in biome.json, because their shape is nobody's to read.
const surfaces: { name: string; baseURL: string; routes: string[] }[] = JSON.parse(
  readFileSync(resolve(process.cwd(), "surfaces.json"), "utf8"),
);

for (const surface of surfaces) {
  for (const route of surface.routes) {
    test(`${surface.name} ${route} has no detectable accessibility violations`, async ({
      page,
    }) => {
      await page.goto(new URL(route, surface.baseURL).href);
      const results = await new AxeBuilder({ page }).analyze();
      expect(results.violations).toEqual([]);
    });
  }
}
