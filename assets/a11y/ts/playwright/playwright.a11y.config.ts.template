import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { defineConfig } from "@playwright/test";

// No ESM-only module-URL API here. Playwright loads a .ts config through a CJS
// transform, and
// `.a11y/package.json` declares no module type, so an ESM-only API here failed with
// "exports is not defined in ES module scope" before any test ran. `just a11y` runs
// from .a11y, so its parent is the repository root.
const configDir = process.cwd();
const repositoryRoot = resolve(configDir, "..");

// The surfaces and web servers are read from JSON at run time rather than inlined.
// A JSON answer has quoted keys, which no JS formatter emits, and its length decides
// whether the formatter wants the call on one line or three -- so no fixed layout in
// this file could satisfy `just check` for every answer. The data files are excluded
// from the formatter in biome.json, because their shape is nobody's to read.
const webServers: { command: string; url: string; cwd: string }[] = JSON.parse(
  readFileSync(resolve(configDir, "web-servers.json"), "utf8"),
);

export default defineConfig({
  testDir: "./tests",
  testMatch: "**/*.pw.ts",
  webServer: webServers.map((server) => ({
    ...server,
    cwd: resolve(repositoryRoot, server.cwd),
    reuseExistingServer: !process.env.CI,
  })),
});
